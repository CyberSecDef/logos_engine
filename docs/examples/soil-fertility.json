{
  "id": "fertility-example",
  "worldId": "first-world",
  "expectedRevision": 0,
  "summary": "Track soil fertility from 0 to 100. Land gains 1 point on rainy days and loses 2 above 40 °C.",
  "operations": [
    {
      "kind": "field-define", "tileId": 0, "migration": "preserve",
      "definition": {"id": "soil-fertility", "version": 1, "label": "Soil fertility", "unit": "points", "description": "A fantasy soil condition; does not yet change built-in vegetation or crop yields.", "min": 0, "max": 100, "defaultValue": 50}
    },
    {
      "kind": "rule-define", "tileId": 0,
      "rule": {
        "id": "rain-replenishes-soil", "version": 1, "label": "Rain replenishes soil", "tileId": 0,
        "scope": "world", "enabled": true, "everyDays": 1,
        "conditions": [
          {"read": {"source": "elevationM", "sample": "self"}, "comparison": "gt", "value": 0},
          {"read": {"source": "rainMm", "sample": "self"}, "comparison": "gte", "value": 3}
        ],
        "effects": [{"fieldId": "soil-fertility", "kind": "add", "value": {"constant": 1, "terms": []}}]
      }
    },
    {
      "kind": "rule-define", "tileId": 0,
      "rule": {
        "id": "heat-depletes-soil", "version": 1, "label": "Heat depletes soil", "tileId": 0,
        "scope": "world", "enabled": true, "everyDays": 1,
        "conditions": [
          {"read": {"source": "elevationM", "sample": "self"}, "comparison": "gt", "value": 0},
          {"read": {"source": "temperatureC", "sample": "self"}, "comparison": "gt", "value": 40}
        ],
        "effects": [{"fieldId": "soil-fertility", "kind": "add", "value": {"constant": -2, "terms": []}}]
      }
    }
  ]
}
