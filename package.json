{
  "name": "logos-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/tests/*.test.js",
    "dev": "tsc && node dist/apps/server/src/index.js --dev",
    "start": "node dist/apps/server/src/index.js",
    "artwork:pack": "tsc && node dist/apps/server/src/artwork-cli.js",
    "world": "tsc && node dist/apps/server/src/cli.js",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:dev-cache": "tsc && node tests/dev-cache.mjs",
    "test:prompts": "npm run build && node tests/prompt-browser.mjs",
    "test:extensions": "npm run build && node tests/extensions-browser.mjs",
    "test:resources": "npm run build && node tests/resources-browser.mjs",
    "test:checkpoints": "npm run build && node tests/checkpoints-browser.mjs",
    "test:plugins": "npm run build && node tests/plugins-browser.mjs",
    "test:textures": "npm run build && node tests/textures-browser.mjs",
    "test:selective": "npm run build && node tests/selective-browser.mjs",
    "test:entities": "npm run build && node tests/entities-browser.mjs",
    "test:portable": "npm run build && node tests/portable-browser.mjs",
    "test:layers": "npm run build && node tests/layers-browser.mjs",
    "test:artwork": "npm run build && node tests/artwork-browser.mjs",
    "test:history": "npm run build && node tests/history-branch-browser.mjs",
    "test:appearance": "npm run build && node tests/appearance-rules-browser.mjs",
    "test:providers:live": "tsc && node tests/providers-live.mjs",
    "test:transport": "npm run build && node tests/transport-browser.mjs",
    "test:settlements": "npm run build && node tests/settlements-browser.mjs",
    "test:ecology": "npm run build && node tests/ecology-browser.mjs",
    "test:food-trade": "npm run build && node tests/food-trade-browser.mjs",
    "test:routes": "npm run build && node tests/routes-browser.mjs",
    "test:journeys": "npm run build && node tests/journeys-browser.mjs",
    "test:neighbor-visits": "npm run build && node tests/neighbor-visits-browser.mjs",
    "test:air-migration": "npm run build && node tests/air-migration-browser.mjs",
    "test:water-quality": "npm run build && node tests/water-quality-browser.mjs",
    "test:conflict": "npm run build && node tests/conflict-browser.mjs",
    "test:armies": "npm run build && node tests/armies-browser.mjs",
    "test:garrisons": "npm run build && node tests/garrisons-browser.mjs",
    "test:faction-borders": "npm run build && node tests/faction-borders-browser.mjs",
    "test:factions": "npm run build && node tests/factions-browser.mjs",
    "test:technology-effects": "npm run build && node tests/technology-effects-browser.mjs",
    "test:knowledge": "npm run build && node tests/knowledge-browser.mjs",
    "test:technology": "npm run build && node tests/technology-browser.mjs",
    "test:disease-contact": "npm run build && node tests/disease-contact-browser.mjs",
    "test:disease": "npm run build && node tests/disease-browser.mjs",
    "test:simulation": "tsc && node tests/simulation-benchmark.mjs",
    "test:simulation-browser": "npm run build && node tests/simulation-browser.mjs",
    "test:review-accessibility": "npm run build && node tests/review-accessibility-browser.mjs",
    "test:navigation": "npm run build && node tests/navigation-browser.mjs"
  },
  "dependencies": {
    "three": "0.186.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.2",
    "@types/three": "0.183.1",
    "vite": "8.3.0",
    "@playwright/test": "1.63.0"
  }
}
