# Local server only. Never expose API credentials to the browser or world files.
HOST=0.0.0.0
PORT=5180
# Optional additional DNS names (comma-separated); IP addresses work by default.
# ALLOWED_HOSTS=logos.example.lan
# Default: installed Claude Code with existing local login; Linux + bubblewrap.
LLM_PROVIDER=claude-code
# Optional model override; otherwise use Claude Code's default.
# CLAUDE_MODEL=sonnet
# CLAUDE_BIN=/absolute/path/to/claude
# Optional direct API alternative (no CLI or sandbox required):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=your-enabled-model-id
# Optional local Cursor CLI (verified version; Linux + bubblewrap):
# LLM_PROVIDER=cursor
# CURSOR_BIN=/absolute/path/to/cursor-agent
# CURSOR_MODEL=your-enabled-model-id
# Uses browser login by default, or an optional server-only key:
# CURSOR_API_KEY=
# Optional local Codex CLI for OpenAI models (Linux + bubblewrap):
# LLM_PROVIDER=codex
# CODEX_BIN=/absolute/path/to/native/codex
# CODEX_MODEL=your-enabled-model-id
# Existing ChatGPT login is used by default, or set an API key for Codex exec:
# CODEX_API_KEY=
